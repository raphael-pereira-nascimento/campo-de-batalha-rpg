# Configuração do servidor

# OPCIONAL. Se você NÃO definir DATABASE_URL, o servidor usa automaticamente
# um banco local PGlite em server/.data/pglite (zero configuração).
# Contas, fichas, gemas e criações ficam salvos nessa pasta.
#
# Para produção ou para usar PostgreSQL, descomente e ajuste a linha abaixo:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/campo_de_batalha

# Porta do servidor (padrão: 3000)
PORT=3000

# Pasta do banco local PGlite (opcional; padrão: server/.data/pglite)
# PGLITE_DIR=./.data/pglite
