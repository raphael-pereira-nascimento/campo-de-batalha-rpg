{
  "name": "campo-de-batalha-rpg",
  "version": "1.0.0",
  "private": true,
  "description": "Batalhas de RPG estilo Final Fantasy/Pokémon em tempo real para até 20 jogadores",
  "type": "module",
  "scripts": {
    "setup": "npm install --prefix server && npm install",
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/src/index.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "npm run test --prefix server",
    "test:e2e": "node smoke-test.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  }
}
